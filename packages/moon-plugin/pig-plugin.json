{
  "apiVersion": 1,
  "id": "com.pigcodets.plugins.moon",
  "name": {
    "zh-CN": "月亮界面",
    "en": "Moon UI"
  },
  "version": "1.0.0",
  "build": 1,
  "entry": "App.tsx",
  "minHostVersion": "1.0.0",
  "protocols": {
    "ui": 1,
    "services": 1
  },
  "capabilities": [
    {
      "name": "ui.patch.structure",
      "targets": ["composer.sendButton"]
    }
  ],
  "contributions": {
    "api_version": 1,
    "description": {
      "zh-CN": "将发送按钮替换为月亮图标",
      "en": "Replace the send button with a moon icon"
    },
    "ui": [
      {
        "id": "moon-send-button",
        "kind": "replaceChildren",
        "target": "composer.sendButton",
        "icon": "moon",
        "preserve": ["onPress", "disabled", "accessibilityLabel", "testID"]
      }
    ]
  }
}
